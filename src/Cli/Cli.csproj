<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TrainSetGuard</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trainset-guard</ToolCommandName>
    <PackageId>TrainSetGuard.Tool</PackageId>
    <Version>0.3.0</Version>
    <Authors>alirezaRanjbar4</Authors>
    <Description>Check chat fine-tuning JSONL for malformed examples, duplicate prompts, conflicting answers, and train/validation leakage.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alirezaRanjbar4/trainset-guard</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alirezaRanjbar4/trainset-guard</PackageProjectUrl>
    <PackageTags>dotnet;csharp;ai;machine-learning;training;cli</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
